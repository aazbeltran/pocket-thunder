{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.blue_war_axolotl.main": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            {"flying": "query.modified_move_speed > 0.1"},
            {"attacking": "query.is_delayed_attacking"}
          ]
        },
        "flying": {
          "animations": ["fly"],
          "transitions": [
            {"attacking": "query.is_delayed_attacking"},
            {"idle": "query.modified_move_speed <= 0.1"}
          ]
        },
        "attacking": {
          "animations": ["attack"],
          "transitions": [
            {"idle": "query.any_animation_finished"}
          ]
        }
      }
    }
  }
}
